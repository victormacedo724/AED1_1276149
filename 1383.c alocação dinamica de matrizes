#include <stdio.h>
#include <stdlib.h>

int verifica_coluna (int **m){
    int i, j, n, x;
    for (n=0; n<9; n++){
        for (x=8; x>=0; x--){
            for (i=0; i<x; i++){
                if (m[x][n] == m[i][n]){
                    return 0;
                }
            }
        }
    }
    return 1;
}

int verifica_linha (int **m){
    int i, j, n, x;
    for (n=0; n<9; n++){
        for (x=8; x>=0; x--){
            for (i=0; i<x; i++){
                if (m[n][x] == m[n][i]){
                    return 0;
                }
            }
        }
    }
    return 1;
}

int verifica_bloco (int **m){
    int i, j, n, x, b, a, d, c;
    for (c=0; c<7; c = c+3){
        for (b=0; b<7; b = b+3){
            for (x=b; x<b+3; x++){ 
                for (a=c; a<c+3; a++){
                    n = m[x][a];
                    for (d=b; d<b+3; d++){
                        for (j=c; j<c+3; j++){
                            if (n == m[d][j] && !(d == x && j == a))
                                return 0;
                        }
                    }
                }
            }
        }
    }
    return 1;
}


int preenche_verifica (int **m){
    int i, j, t;
    for (i=0; i<9; i++){
        for (j=0; j<9; j++){
            scanf ("%d", &m[i][j]);
        }
    }
    t = verifica_linha (m);
    if (t == 0)
        return t;
    else{
        t = verifica_coluna(m);
        if (t == 0)
            return t;
        else {
            t = verifica_bloco(m);
            if (t == 0)
                return t;
        }  
    }
    return 1;
}

int main(){
    int i=0, n=0, x, l=9, c=9;
    int **m;
    while (n<=0)
        scanf ("%d", &n); 
    for (i=1; i<=n; i++){
        m = malloc (l * sizeof(int *));
        if (m == NULL){
            printf("Erro ao alocar memória!\n");
            return 1;
        }
        for (int ma=0; ma<l; ma++){
            m[ma] = malloc (c * sizeof(int));
        } //matriz criada com sucesso!
        x = preenche_verifica (m);
        if (x == 0)
            printf ("Instancia %d\nNAO\n\n", i);
        else 
            printf ("Instancia %d\nSIM\n\n", i);
        for (int ma = 0; ma<l; ma++)
            free (m[ma]);
            //liberar a bichinha linha por linha
        free (m);
        //libera a primeira coluna
        m = NULL;
        //desaponta o ponteiro
    }
    return 0;
}
